[Simulation]
Name=Dogrib
LowerLeftLatLon=51.621113,-115.609849
DomainSize=40000.0,30000.0
DeltaTime=30.0
StartDateTime=2001-09-29T17:00:00
EndDateTime=2001-10-17T00:00:00
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=12

[Weather]
WeatherFile=dogrib_weather.csv
DesiredLatLon=51.6547,-115.3617

[Population]
PopulationFile=population/big_population.csv
CullOutsideGroups=false

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.0

[Demographics]
Name=two_cars
AllowMoreThanOneCar=true
MaxCars=2
MaxCarsProbability=1.0

[Evacuation]
EvacuationOrderStart=0.0
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=route85
LatLon=39.5071781907873,-105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=route121
LatLon=39.503415, -105.092083
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[EvacuationGroup]
Name=route85_group
Default=true
Demographics=two_cars
DestinationChoice=EvacGroupCDF
ShapeFile=groups/east.shp
ResponseCurves=slow, fast
ResponseCurvesCDF=0.9, 1.0
Destinations=route85, route121
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=route121_group
Demographics=one_car
DestinationChoice=EvacGroupCDF
ShapeFile=groups/west.shp
ResponseCurves=slow, fast 
ResponseCurvesCDF=0.1, 1.0
Destinations=route121, route85
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[ResponseCurve]
Name=slow
0, 0
12000, 0.0
12500, 1.0

[ResponseCurve]
Name=fast
0, 0
450, 0.8
900, 1.0

[PedestrianModule]
Enabled=false
Module=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[TrafficModule]
Enabled=false
Module=SUMO      
VisibilityAffectsSpeed=false  

[SUMO]
ConfigurationFile=sumo/rox.sumocfg
UTMoffset=-491253.49,-4359238.56
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[WildfireModule]
Enabled=true
Module=CellParticleHybrid
LcpFile=dogrib_landscape_UTM.tif
GraphicalFireInputFile=fire/example.gfi

[CellParticleHybrid]
IgnitionPointsFile=ignitions.ign
UseRandomIgnitionMap=false
RandomIgnitionPoints=0
UseInitialIgnitionMap=false
SpreadRateModel=CanadianFBP
FBPLookupTableFile=fbp_lookup_table.csv
StartDC=482
StartDMC=58
StartFFMC=89
StartHourlyFFMC=94

[TriggerBufferModule]
Enabled=false
Module=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[SmokeModule]
Enabled=false
Module=AdvectDiffuse3D

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc

[AdvectDiffuse3D]
MixingLayerHeight=250.0

[AdvectDiffuseMixingLayer]
MixingLayerHeight=250.0

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0