[Simulation]
Name=Roxborough_global_smoke
LowerLeftLatLon=39.409924,-105.104505
DomainSize=10000.0,11000.0
DeltaTime=1.0
MaxSimTime=36000.0
RunPedestrianModule=true
RunTrafficModule=true
RunFireModule=true
RunSmokeModule=true
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Population]
PopulationFile=population/big_population.csv
CullOutsideGroups=true

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.3

[Evacuation]
EvacuationOrderStart=0.0
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=goal_highway
LatLon=39.5071781907873, -105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=goalE
LatLon=39.427991, -105.073289
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[Destination]
Name=goalF
LatLon=39.466157, -105.082197
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=.0,1.0,0.0

[Destination]
Name=goalR
LatLon=39.473858, -105.092137
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=0.0,0.0,1.0

[ResponseCurve]
Name=observed_average
0, 0
300, 0.037
1080, 0.67
1860, 0.76
1980, 0.85
6300, 1.0

[ResponseCurve]
Name=reported_average
0, 0
900, 0.79
1800, 0.91
2700, 0.93
3600, 0.97
5400, 1.0

[EvacuationGroup]
Name=groupA
Demographics=one_car
DestinationChoice=EvacGroupWeighted
ShapeFile=groups/groupA.shp
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Destinations=goalE, goalR, goalF
DestinationsCDF=0.4,0.7,1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=groupB
Demographics=one_car
ShapeFile=groups/groupB.shp
DestinationChoice=EvacGroupWeighted
Destinations=goalE, goalR, goalF
DestinationsCDF=0.25, 0.75, 1.0
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=groupC
Demographics=one_car
ShapeFile=groups/groupC.shp
DestinationChoice=EvacGroupWeighted
Destinations=goalE, goalR, goalF
DestinationsCDF=0.1, 0.2, 1.0
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Color=0.0,1.0,0.0

[Pedestrian]
PedestrianModule=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[Traffic]
TrafficModule=SUMO      
VisibilityAffectsSpeed=false  

[SUMO]
ConfigurationFile=sumo/rox.sumocfg
UTMoffset=-491253.49,-4359238.56
DestinationChoice=EvacGroupWeighted
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[Fire]
FireModule=AscImport
LcpFile=fire/rox_big_burning_city.lcp
GraphicalFireInputFile=fire/example.gfi

[AscImport]
RootFolder=flammap
TimeOfArrivalFile=output/TOA.asc
RateOfSpreadFile=output/ROS.asc
SpreadDirectionFile=output/SD.asc
FirelineIntensityFile=output/FI.asc
WeatherStreamFile=weather_stream.wxs

[TriggerBuffer]
CalculateTriggerBuffer=false
TriggerBuffer=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0

[Smoke]
SmokeModule=GlobalSmoke

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc