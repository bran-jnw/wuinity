[Simulation]
Name=Development
LowerLeftLatLon=39.409924,-105.104505
DomainSize=10000.0,11000.0
DeltaTime=1.0
MaxSimTime=36000.0
RunPedestrianModule=true
RunTrafficModule=true
RunFireModule=true
RunSmokeModule=true
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Population]
PopulationFile=population/small_population.csv
MinHouseholdSize=1
MaxHouseholdSize=5
AllowMoreThanOneCar=false
MaxCars=2
MaxCarsProbability=0.3

[Evacuation]
EvacuationOrderStart=0.0
EvacuationDestinationFiles=destinations/route85.ed,destinations/route121.ed
ResponseCurveFiles=responseCurves/Observed_average.csv
EvacuationGroupFiles=groups/group_highways.eg
EvacuationGroupsMapFile=groups/Development.egs
PaintCellSize=200.0
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=route85
LatLon=39.5071781907873,-105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=route121
Default=true
LatLon=39.503415, -105.092083
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[EvacuationGroup]
Name=route85_group
ShapeFile=groups/east.shp
ResponseCurves=east_fast, west_slow
ResponseCurvesCDF=0.9, 1.0
Destinations=route85, route121
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=route121_group
ShapeFile=groups/west.shp
ResponseCurves=east_fast, west_slow
ResponseCurvesCDF=0.1, 1.0
Destinations=route121, route85
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[ResponseCurve]
Name=west_slow
0, 0
4500, 0.8
9000, 1.0

[ResponseCurve]
Name=east_fast
0, 0
450, 0.8
900, 1.0

[Pedestrian]
PedestrianModule=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[Traffic]
TrafficModule=SUMO      
VisibilityAffectsSpeed=false  

[SUMO]
ConfigurationFile=sumo/rox.sumocfg
UTMoffset=-491253.49,-4359238.56
DestinationChoice=EvacGroupWeighted

[Fire]
FireModule=CellParticleHybrid
LcpFile=fire/rox_big_burning_city.lcp
GraphicalFireInputFile=fire/example.gfi

[CellParticleHybrid]
RootFolder=fireCell
FuelModelsFile=default.fuel
InitialFuelMoistureFile=default.fmc
IgnitionPointsFile=example.ign
WeatherFile=example.wtr
WindFile=example_seconds.wnd 
UseRandomIgnitionMap=false
RandomIgnitionPoints=0
UseInitialIgnitionMap=false

[AscImport]
RootFolder=flammap
TimeOfArrivalFile=output/TOA.asc
RateOfSpreadFile=output/ROS.asc
SpreadDirectionFile=output/SD.asc
FirelineIntensityFile=output/FI.asc
WeatherStreamFile=weather_stream.wxs

[TriggerBuffer]
CalculateTriggerBuffer=false
TriggerBuffer=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[Smoke]
SmokeModule=AdvectDiffuse3D

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc

[AdvectDiffuse3D]
MixingLayerHeight=250.0

[AdvectDiffuseMixingLayer]
MixingLayerHeight=250.0

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0