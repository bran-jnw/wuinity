[Simulation]
Name=Development
LowerLeftLatLon=39.409924,-105.104505
DomainSize=10000.0,11000.0
DeltaTime=1.0
StartDateTime=2023-06-05T11:00:00
EndDateTime=2023-06-06T11:00:00
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=development_weather.csv

[Population]
PopulationFile=population/big_population.csv
CullOutsideGroups=false

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.0

[Demographics]
Name=two_cars
AllowMoreThanOneCar=true
MaxCars=2
MaxCarsProbability=1.0

[Evacuation]
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=route85
LatLon=39.5071781907873,-105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=route121
LatLon=39.503415, -105.092083
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[EvacuationGroup]
Name=route85_group
EvacuationOrderDateTime=2023-06-05T11:00:00
Default=true
Demographics=two_cars
DestinationChoice=EvacGroupCDF
ShapeFile=groups/east.shp
ResponseCurves=slow, fast
ResponseCurvesCDF=0.9, 1.0
Destinations=route85, route121
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=route121_group
EvacuationOrderDateTime=2023-06-05T11:00:00
Demographics=one_car
DestinationChoice=EvacGroupCDF
ShapeFile=groups/west.shp
ResponseCurves=slow, fast 
ResponseCurvesCDF=0.1, 1.0
Destinations=route121, route85
DestinationsCDF=0.9, 1.0
Color=1.0,1.0,0.0

[ResponseCurve]
Name=slow
TimeInput=Absolute
2023-06-05T11:00:00, 0.0
2023-06-05T14:20:00, 0.0
2023-06-05T14:10:00, 1.0

[ResponseCurve]
Name=fast
TimeInput=Relative
0, 0
450, 0.8
900, 1.0

[PedestrianModule]
Enabled=true
Module=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[TrafficModule]
Enabled=true
Module=SUMO      
VisibilityAffectsSpeed=false  

[SUMO]
ConfigurationFile=sumo/rox.sumocfg
UTMoffset=-491253.49,-4359238.56
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[WildfireModule]
Enabled=true
Module=SimpleWildfireCA #AscImport
GraphicalFireInputFile=fire/example.gfi

[SimpleWildfireCA]
LandscapeFile=fire/rox_big_burning_city.lcp
FuelModelsFile=fireCell/default.fuel
InitialFuelMoistureFile=fireCell/default.fmc
IgnitionPointsFile=fireCell/example.ign
UseRandomIgnitionMap=false
RandomIgnitionPoints=0
UseInitialIgnitionMap=false
SpreadRateModel=Behave #LookUpTable, CanadianFBP
StartDC=482
StartDMC=58
StartFFMC=89
StartHourlyFFMC=85
LookUpTableFile=fire/constant_spreadrates.csv

[AscImport]
RootFolder=flammap
TimeOfArrivalFile=output/TOA.asc
RateOfSpreadFile=output/ROS.asc
SpreadDirectionFile=output/SD.asc
FirelineIntensityFile=output/FI.asc
WeatherStreamFile=weather_stream.wxs

[TriggerBufferModule]
Enabled=false
Module=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[SmokeModule]
Enabled=false
Module=AdvectDiffuse3D

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc

[AdvectDiffuse3D]
MixingLayerHeight=250.0

[AdvectDiffuseMixingLayer]
MixingLayerHeight=250.0

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0