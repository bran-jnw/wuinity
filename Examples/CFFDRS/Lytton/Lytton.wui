[Simulation]
Name=Lytton
LowerLeftLatLon=50.196615, -121.665957
DomainSize=10000.0,10000.0
DeltaTime=1.0
StartDateTime=2021-06-29T12:00:00
EndDateTime=2021-07-05T00:00:00
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=lytton_weather.csv
DesiredLatLon=50.228701345102586, -121.54306201686576

[Population]
PopulationFile=population/worldpop_population_clipped.csv
CullOutsideGroups=true

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.0

[Demographics]
Name=two_cars
AllowMoreThanOneCar=true
MaxCars=2
MaxCarsProbability=1.0

[Evacuation]
EvacuationOrderStart=0.0
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=Highway12
LatLon=50.276342, -121.598340
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=Highway1
LatLon=50.254070, -121.517087
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[EvacuationGroup]
Name=lytton
Default=true
Demographics=one_car
DestinationChoice=EvacGroupCDF 
ShapeFile=groups/lytton_all.shp
ResponseCurves=made_up
ResponseCurvesCDF=1.0
Destinations=Highway1, Highway12
DestinationsCDF=0.2, 1.0
Color=1.0,1.0,0.0

[ResponseCurve]
Name=made_up
TimeInput=Absolute
2021-06-30T17:30:00, 0.0
2021-06-30T20:00:00, 1.0

[PedestrianModule]
Enabled=true
Module=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[TrafficModule]
Enabled=true
Module=SUMO      
VisibilityAffectsSpeed=false  

[SUMO]
ConfigurationFile=sumo/osm.sumocfg
UTMoffset=-591146.13,-5556903.75
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[WildfireModule]
Enabled=true
Module=CellParticleHybrid #AscImport
GraphicalFireInputFile=fire/example.gfi

[CellParticleHybrid]
LandscapeFile=wildfire/lytton_edited2.tif
IgnitionPointsFile=lytton.ign
UseRandomIgnitionMap=false
RandomIgnitionPoints=0
UseInitialIgnitionMap=false
SpreadRateModel=CanadianFBP
FBPLookupTableFile=wildfire/fbp_lookup_table.csv
StartDC=482
StartDMC=58
StartFFMC=96
StartHourlyFFMC=96

[AscImport]
StartDateTime=2021-06-30T16:30:00
TimeOfArrivalFile=wildfire/TOA.asc
RateOfSpreadFile=wildfire/ROS.asc
SpreadDirectionFile=wildfire/SD.asc
FirelineIntensityFile=wildfire/FI.asc

[TriggerBufferModule]
Enabled=false
Module=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[SmokeModule]
Enabled=false
Module=AdvectDiffuse3D

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc

[AdvectDiffuse3D]
MixingLayerHeight=250.0

[AdvectDiffuseMixingLayer]
MixingLayerHeight=250.0

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0