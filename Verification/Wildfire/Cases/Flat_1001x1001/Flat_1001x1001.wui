[Simulation]
Name=Flat_1001x1001
LowerLeftLatLon=55.60980,13.29195
DomainSize=30030.0,30030.0
DeltaTime=1.0
StartDateTime=2025-01-01T00:00:00
EndDateTime=2025-01-01T01:53:00 #04:10:15
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=verification_weather.csv

[WildfireModule]
Enabled=true
Module=NarrowLevelSet

[CellParticleHybrid]
LandscapeFile=flat_1001x1001.tif
CentroidMode=Center #Center, Random, RandomCross, RandomCircle
RandomAmount=0.5
ThetaLimit=5.0
IgnitionPointsFile=center.ign
SpreadRateModel=LookupROS #Behave, LookupROS
FuelModelsFile=default.fuel
InitialFuelMoistureFile=default.fmc
LookUpTableFile=constant_spreadrates.csv

[NarrowLevelSet]
LandscapeFile=flat_1001x1001.tif
IgnitionPointsFile=center.ign
SpreadRateModel=LookupROS #Behave, LookupROS
LookUpTableFile=constant_spreadrates.csv