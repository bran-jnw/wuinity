[Simulation]
Name=Flat_1001x1001
LowerLeftLatLon=55.60980,13.29195
DomainSize=30030.0,30030.0
DeltaTime=1.0
StartDateTime=2025-01-01T00:00:00
EndDateTime=2025-01-01T03:47:30 #04:10:15
StopWhenEvacuated=false

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=verification_weather.csv

[WildfireModule]
Enabled=true
Module=CellParticleHybrid

[CellParticleHybrid]
LandscapeFile=flat_1001x1001.tif
CentroidMode=Random #Center, Random, RandomCross, RandomCircle
RandomAmount=0.5
IgnitionPointsFile=ignition.ign
SpreadRateModel=Behave #Behave, LookUpTable

FuelModelsFile=default.fuel
InitialFuelMoistureFile=default.fmc
LookUpTableFile=constant_spreadrates.csv